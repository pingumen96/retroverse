// A mock catalog (retroverse.exe --mock-catalog, rv::app::MockCatalog) whose games launch tests/fake_emulator's
// rv_fake_emulator, one behavior per profile: the GPU smoke tests of tests/smoke/test_launch.cpp. Invented titles,
// generic platforms. A template: the test replaces @FAKE_EMULATOR@ with the fake of its build, @GUARD_COPY@ with a copy
// of it under another name (not on RV_LAUNCH_ALLOWLIST), @MISSING_EMULATOR@ with a path where no program is, writes
// the result into its case directory beside the ROM files it creates (roms/<name>.gb) and keeps the games it needs.
// The profiles start the fake in the ROM's folder (the case directory) without a console window, and every fake ends
// by itself (--exit-timeout-ms) whatever the test does.
{
  "schemaVersion": 1,
  "profiles": [
    {"id": "fake-return", "displayName": "Emulatore di prova",
     "executable": "@FAKE_EMULATOR@",
     "arguments": ["--sleep-ms", "2500", "--exit-timeout-ms", "30000", "--print-args", "fake-return-args.json", "--",
                   "{rom}", "{system}"],
     "workingDirectory": "{rom_dir}", "hideConsoleWindow": true},
    {"id": "fake-quick", "displayName": "Emulatore di prova",
     "executable": "@FAKE_EMULATOR@",
     "arguments": ["--exit-timeout-ms", "30000", "--", "{rom}"],
     "workingDirectory": "{rom_dir}", "hideConsoleWindow": true},
    {"id": "fake-error", "displayName": "Emulatore di prova",
     "executable": "@FAKE_EMULATOR@",
     "arguments": ["--exit-code", "3", "--exit-timeout-ms", "30000", "--", "{rom}"],
     "workingDirectory": "{rom_dir}", "hideConsoleWindow": true},
    {"id": "fake-crash", "displayName": "Emulatore di prova",
     "executable": "@FAKE_EMULATOR@",
     "arguments": ["--crash", "--exit-timeout-ms", "30000", "--", "{rom}"],
     "workingDirectory": "{rom_dir}", "hideConsoleWindow": true},
    {"id": "fake-hang", "displayName": "Emulatore di prova",
     "executable": "@FAKE_EMULATOR@",
     "arguments": ["--hang", "--exit-timeout-ms", "12000", "--print-args", "fake-hang-args.json", "--", "{rom}"],
     "workingDirectory": "{rom_dir}", "hideConsoleWindow": true},
    {"id": "fake-confirm", "displayName": "Emulatore di prova",
     "executable": "@FAKE_EMULATOR@",
     "arguments": ["--sleep-ms", "2500", "--exit-timeout-ms", "30000", "--", "{rom}"],
     "workingDirectory": "{rom_dir}", "hideConsoleWindow": true, "wait": "confirm"},
    {"id": "fake-still-running", "displayName": "Emulatore di prova",
     "executable": "@FAKE_EMULATOR@",
     "arguments": ["--sleep-ms", "6000", "--exit-timeout-ms", "30000", "--", "{rom}"],
     "workingDirectory": "{rom_dir}", "hideConsoleWindow": true, "windowTimeoutSeconds": 1},
    {"id": "fake-window", "displayName": "Emulatore di prova",
     "executable": "@FAKE_EMULATOR@",
     "arguments": ["--frames", "500", "--exit-timeout-ms", "30000", "--log", "fake-window-log.json", "--", "{rom}"],
     "workingDirectory": "{rom_dir}", "hideConsoleWindow": true},
    {"id": "fake-unset-variable", "displayName": "Emulatore di prova",
     "executable": "@FAKE_EMULATOR@",
     "arguments": ["--core", "{var:core}", "--", "{rom}"],
     "workingDirectory": "{rom_dir}", "hideConsoleWindow": true},
    {"id": "fake-not-listed", "displayName": "Emulatore copiato",
     "executable": "@GUARD_COPY@",
     "arguments": ["--exit-timeout-ms", "30000", "--", "{rom}"],
     "workingDirectory": "{rom_dir}", "hideConsoleWindow": true},
    {"id": "fake-missing", "displayName": "Emulatore assente",
     "executable": "@MISSING_EMULATOR@",
     "arguments": ["{rom}"]}
  ],
  "games": [
    {"id": "g000000000000a001", "title": "Lanterna di Vetro", "platform": "Portatile 8 bit", "year": 1991,
     "developer": "Studio Ventaglio", "publisher": "Edizioni Faro", "genre": "Rompicapo", "players": "1",
     "description": "Una lanterna da riaccendere stanza dopo stanza, prima che si spenga l'ultima candela.",
     "launch": {"profile": "fake-return", "rom": "roms/lanterna.gb", "system": "gb"}},
    {"id": "g000000000000a002", "title": "Il Faro Sommerso", "platform": "Portatile 8 bit", "year": 1992,
     "developer": "Studio Ventaglio", "genre": "Avventura", "players": "1",
     "launch": {"profile": "fake-quick", "rom": "roms/faro.gb", "system": "gb"}},
    {"id": "g000000000000a003", "title": "Corsa nel Deserto Rosso", "platform": "Console 16 bit", "year": 1994,
     "developer": "Officine Bussola", "genre": "Corse", "players": "1-2",
     "launch": {"profile": "fake-error", "rom": "roms/deserto.gb", "system": "gb"}},
    {"id": "g000000000000a004", "title": "La Torre degli Orologi", "platform": "Console 16 bit", "year": 1993,
     "developer": "Officine Bussola", "genre": "Piattaforme", "players": "1",
     "launch": {"profile": "fake-crash", "rom": "roms/torre.gb", "system": "gb"}},
    {"id": "g000000000000a005", "title": "Treno di Mezzanotte", "platform": "Console 16 bit", "year": 1995,
     "developer": "Laboratorio Gru", "genre": "Azione", "players": "1",
     "launch": {"profile": "fake-hang", "rom": "roms/treno.gb", "system": "gb"}},
    {"id": "g000000000000a006", "title": "Il Giardino Capovolto", "platform": "Portatile 8 bit", "year": 1990,
     "developer": "Laboratorio Gru", "genre": "Rompicapo", "players": "1",
     "launch": {"profile": "fake-confirm", "rom": "roms/giardino.gb", "system": "gb"}},
    {"id": "g000000000000a007", "title": "Ombre sul Lago", "platform": "Arcade", "year": 1989,
     "developer": "Sala Giochi Aurora", "genre": "Sparatutto", "players": "1-2",
     "launch": {"profile": "fake-still-running", "rom": "roms/ombre.gb", "system": "gb"}},
    {"id": "g000000000000a008", "title": "Fiume di Rame", "platform": "Arcade", "year": 1988,
     "developer": "Sala Giochi Aurora", "genre": "Azione", "players": "1",
     "launch": {"profile": "fake-window", "rom": "roms/fiume.gb", "system": "gb"}},
    {"id": "g000000000000a009", "title": "Pianeta Senza Nome", "platform": "Console 16 bit", "year": 1996,
     "developer": "Officine Bussola", "genre": "Strategia", "players": "1",
     "launch": {"profile": "fake-unset-variable", "rom": "roms/pianeta.gb", "system": "gb"}},
    {"id": "g000000000000a010", "title": "Cavalieri di Sabbia", "platform": "Console 16 bit", "year": 1994,
     "developer": "Laboratorio Gru", "genre": "Picchiaduro", "players": "1-2",
     "launch": {"profile": "fake-not-listed", "rom": "roms/cavalieri.gb", "system": "gb"}},
    {"id": "g000000000000a011", "title": "Isola delle Lucciole", "platform": "Portatile 8 bit", "year": 1993,
     "developer": "Studio Ventaglio", "genre": "Avventura", "players": "1",
     "launch": {"profile": "fake-missing", "rom": "roms/isola.gb", "system": "gb"}},
    {"id": "g000000000000a012", "title": "Fiume di Rame II", "platform": "Arcade", "year": 1990,
     "developer": "Sala Giochi Aurora", "genre": "Azione", "players": "1",
     "launch": {"profile": "fake-return", "rom": "roms/assente.gb", "system": "gb"}},
    {"id": "g000000000000a013", "title": "Biblioteca Silenziosa", "platform": "Console 16 bit", "year": 1997,
     "developer": "Laboratorio Gru", "genre": "Avventura", "players": "1"}
  ]
}
