  {"fromFrame": 14, "toFrame": 14, "actions": {"ui_activate": 1}},
  {"fromFrame": 20, "toFrame": 20, "actions": {"ui_back": 1}},
  {"fromFrame": 26, "toFrame": 26, "actions": {"ui_back": 1}},
