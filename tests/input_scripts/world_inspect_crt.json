// I3 step 13b: the hero CRT follows the world's selection after its 300 ms dwell, in the generated room of the snes-room
// fixture. The walker starts at the Focus pose of the hero wall's band item fx:hw-w/s:5.4 (--spawn), the reticle on it.
//   frame 40          interact: the face-out item is inspected (the CRT's selection after 300 ms: 18 frames)
//   frame 70          ui_back (Indietro): Focus on the same item (no new selection)
//   frames 100, 110,  ui_right taps: a D-pad step every 10 frames (167 ms), faster than the dwell: the CRT keeps the
//   120, 130          inspected item's clip while they go on
//   from frame 131    the last item stays focused: the CRT switches to it 300 ms later (by frame 149)
// tests/smoke/test_world_inspect.cpp compares the run report's video record (the game shown, its selections) of a run
// ending at frame 145 with one ending at frame 170.
//   retroverse --spawn <fx:hw-w/s:5.4's Focus pose> --input-script tests/input_scripts/world_inspect_crt.json
//     --exit-after-frames --frames 170 --fixed-dt 0.016667 --hidden --data-dir <a data directory with the fixture>
[
  {"fromFrame": 40, "toFrame": 40, "actions": {"interact": 1}},
  {"fromFrame": 70, "toFrame": 70, "actions": {"ui_back": 1}},
  {"fromFrame": 100, "toFrame": 100, "actions": {"ui_right": 1}},
  {"fromFrame": 110, "toFrame": 110, "actions": {"ui_right": 1}},
  {"fromFrame": 120, "toFrame": 120, "actions": {"ui_right": 1}},
  {"fromFrame": 130, "toFrame": 130, "actions": {"ui_right": 1}}
]
