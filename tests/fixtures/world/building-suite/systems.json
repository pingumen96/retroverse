    {"system": "fbneo", "kind": "arcade", "family": "generic_case", "order": 102, "sign": "ARCADE",
     "platforms": ["arcade"]},
    {"system": "nes", "kind": "home", "generation": 3, "family": "cartridge_home_8bit", "order": 300,
     "sign": "8-BIT HOME", "platforms": ["nes"]},
    {"system": "snes", "kind": "home", "generation": 4, "family": "cartridge_home_16bit", "order": 400,
     "sign": "16-BIT CORNER", "platforms": ["snes"]},
    {"system": "sfc", "kind": "home", "generation": 4, "family": "cartridge_home_16bit", "order": 401,
