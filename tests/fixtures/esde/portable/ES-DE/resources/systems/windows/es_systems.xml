<?xml version="1.0"?>
<!-- The game systems of the portable fixture: ES-DE's format with an invented emulator (see README.md) -->
<systemList>
    <system>
        <name>nes</name>
        <fullname>Nintendo Entertainment System</fullname>
        <path>%ROMPATH%\nes</path>
        <extension>.nes .NES .zip .ZIP</extension>
        <command label="Portable Emulator">%EMULATOR_PORTABLE-EMULATOR% -- %ROM%</command>
        <platform>nes</platform>
        <theme>nes</theme>
    </system>
    <system>
        <name>megadrive</name>
        <fullname>Sega Mega Drive</fullname>
        <path>%ROMPATH%\megadrive</path>
        <extension>.md .MD .bin .BIN .zip .ZIP</extension>
        <command label="Portable Emulator">%EMULATOR_PORTABLE-EMULATOR% -- %ROM%</command>
        <platform>genesis, megadrive</platform>
        <theme>megadrive</theme>
    </system>
</systemList>
