<?xml version="1.0"?>
<!-- The overflow fixture's two systems under ES-DE's names, their full names invented (see README.md) -->
<systemList>
    <system>
        <name>mame</name>
        <fullname>Arcade Board Library</fullname>
        <path>%ROMPATH%\mame</path>
        <extension>.zip .ZIP</extension>
        <command label="Fake Emulator">%EMULATOR_FAKE-EMULATOR% -- %ROM%</command>
        <platform>arcade</platform>
        <theme>mame</theme>
    </system>
    <system>
        <name>amiga</name>
        <fullname>Lumen Desk Computer</fullname>
        <path>%ROMPATH%\amiga</path>
        <extension>.adf .ADF .zip .ZIP</extension>
        <command label="Fake Emulator">%EMULATOR_FAKE-EMULATOR% -- %ROM%</command>
        <platform>amiga</platform>
        <theme>amiga</theme>
    </system>
</systemList>
