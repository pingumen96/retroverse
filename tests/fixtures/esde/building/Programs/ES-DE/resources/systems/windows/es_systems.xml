<?xml version="1.0"?>
<!-- The building fixture's systems under ES-DE's names, their full names invented (see README.md); megadrive's folder
     comes with additions/ -->
<systemList>
    <system>
        <name>mame</name>
        <fullname>Arcade Board Library</fullname>
        <path>%ROMPATH%\mame</path>
        <extension>.zip .ZIP</extension>
        <command label="Fake Emulator">%EMULATOR_FAKE-EMULATOR% -- %ROM%</command>
        <platform>arcade</platform>
        <theme>mame</theme>
    </system>
    <system>
        <name>snes</name>
        <fullname>Lumen 16 Home System</fullname>
        <path>%ROMPATH%\snes</path>
        <extension>.sfc .SFC .smc .SMC .zip .ZIP</extension>
