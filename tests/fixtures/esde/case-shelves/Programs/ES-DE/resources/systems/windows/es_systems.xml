<?xml version="1.0"?>
<!-- The case-shelves fixture's systems under ES-DE's names, their full names invented (see README.md) -->
<systemList>
    <system>
        <name>psx</name>
        <fullname>Orbit Disc System</fullname>
        <path>%ROMPATH%\psx</path>
        <extension>.chd .CHD .cue .CUE .m3u .M3U</extension>
        <command label="Fake Emulator">%EMULATOR_FAKE-EMULATOR% -- %ROM%</command>
        <platform>psx</platform>
        <theme>psx</theme>
    </system>
    <system>
        <name>ps2</name>
        <fullname>Prism Disc Console</fullname>
        <path>%ROMPATH%\ps2</path>
        <extension>.iso .ISO .chd .CHD</extension>
        <command label="Fake Emulator">%EMULATOR_FAKE-EMULATOR% -- %ROM%</command>
        <platform>ps2</platform>
        <theme>ps2</theme>
    </system>
    <system>
        <name>gb</name>
        <fullname>Pocket Lumen</fullname>
        <path>%ROMPATH%\gb</path>
        <extension>.gb .GB .zip .ZIP</extension>
        <command label="Fake Emulator">%EMULATOR_FAKE-EMULATOR% -- %ROM%</command>
        <platform>gb</platform>
        <theme>gb</theme>
    </system>
    <system>
        <name>amiga</name>
        <fullname>Lumen Desk Computer</fullname>
        <path>%ROMPATH%\amiga</path>
        <extension>.adf .ADF .zip .ZIP</extension>
        <command label="Fake Emulator">%EMULATOR_FAKE-EMULATOR% -- %ROM%</command>
        <platform>amiga</platform>
        <theme>amiga</theme>
    </system>
</systemList>
