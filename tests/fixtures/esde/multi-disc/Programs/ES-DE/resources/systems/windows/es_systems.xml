<?xml version="1.0"?>
<!-- The game systems of the multi-disc fixture: ES-DE's format with an invented emulator (see README.md) -->
<systemList>
    <system>
        <name>psx</name>
        <fullname>Sony PlayStation</fullname>
        <path>%ROMPATH%\psx</path>
        <extension>.bin .BIN .chd .CHD .cue .CUE .m3u .M3U</extension>
        <command label="Fake Emulator">%EMULATOR_FAKE-EMULATOR% -- %ROM%</command>
        <platform>psx</platform>
        <theme>psx</theme>
    </system>
    <system>
        <name>ps2</name>
        <fullname>Sony PlayStation 2</fullname>
        <path>%ROMPATH%\ps2</path>
        <extension>.bin .BIN .chd .CHD .iso .ISO</extension>
        <command label="Fake Emulator">%EMULATOR_FAKE-EMULATOR% -- %ROM%</command>
        <platform>ps2</platform>
        <theme>ps2</theme>
    </system>
</systemList>
