    // aperture grille, a slight barrel curvature with dark rounded corners and a soft vignette, behind hazy glass
    // whose faint sheen of the room's lights shows on the tube's dark border and never washes out the picture.
    // Scanlines and grille fade out below a few pixels: legible at any distance.
    "MAT_Screen_CRT": {
      "shading": "unlit", "baseColor": "#FFFFFF", "emissiveStrength": 2.0,
      "crt": {"lineCount": 240, "scanlineStrength": 0.35, "maskTriadCount": 320, "maskStrength": 0.25,
              "curvature": 0.06, "vignette": 0.3, "glassReflection": 0.25}
    },
    // The generated rooms' CRT (I3 step 16): the same tube a little less bright, so that the filmic tonemap keeps its
    // picture's colours (at 2.0 the brightest bars roll off towards white): the screen stays the room's most saturated
    // picture beside the sign, in tungsten light.
    "MAT_Screen_CRT_Room": {
      "shading": "unlit", "baseColor": "#FFFFFF", "emissiveStrength": 1.3,
      "crt": {"lineCount": 240, "scanlineStrength": 0.35, "maskTriadCount": 320, "maskStrength": 0.25,
              "curvature": 0.06, "vignette": 0.3, "glassReflection": 0.25}
    },
    // I6 step 6's arcade cabinets (style §5.4, §14.4: original, generic, no artwork): the black laminate of their
    // fronts, two deep paints for their side panels (a plum and an oxblood, so that a row reads as distinct cabinets),
    // lit T-mouldings in the arcade's magenta and cyan (dimmer than the room's neon), the marquees' lit faces (a picture
    // of the scene's own times the colour), the dark glass of the screens' borders, an empty cabinet's idle screen (its
    // dim lettering), and the games' screens: the collection's front layer through a picture tube (the CRT's grille and
    // scanlines on an unlit, layered material).
    "MAT_Cabinet_Laminate": { "baseColor": "#151318", "metallic": 0.0, "roughness": 0.45 },
    "MAT_Cabinet_Paint_Plum": { "baseColor": "#3A2148", "metallic": 0.0, "roughness": 0.38 },
    "MAT_Cabinet_Paint_Oxblood": { "baseColor": "#4E1A22", "metallic": 0.0, "roughness": 0.38 },
    "MAT_Cabinet_Paint_Walnut": { "baseColor": "#3B2A20", "metallic": 0.0, "roughness": 0.42 },
    "MAT_Molding_Magenta": { "shading": "unlit", "baseColor": "#C85AD8", "emissiveStrength": 1.1 },
    "MAT_Molding_Cyan": { "shading": "unlit", "baseColor": "#4CC0D8", "emissiveStrength": 1.1 },
    "MAT_Marquee_Magenta": { "shading": "unlit", "baseColor": "#F07ADC", "emissiveStrength": 1.5 },
    "MAT_Marquee_Cyan": { "shading": "unlit", "baseColor": "#7ADCF0", "emissiveStrength": 1.5 },
    "MAT_Marquee_Amber": { "shading": "unlit", "baseColor": "#FFC88A", "emissiveStrength": 1.3 },
    "MAT_Screen_Off": { "baseColor": "#08090C", "metallic": 0.0, "roughness": 0.3 },
    "MAT_Screen_Idle": { "shading": "unlit", "baseColor": "#3A6E86", "emissiveStrength": 0.7 },
    "MAT_Screen_Arcade": {
      "shading": "unlit", "baseColor": "#FFFFFF", "emissiveStrength": 1.15,
      "crt": {"lineCount": 240, "scanlineStrength": 0.3, "maskTriadCount": 240, "maskStrength": 0.2,
              "curvature": 0.04, "vignette": 0.25, "glassReflection": 0.2}
    },
    // Fabric shade lit from the inside by a warm tungsten bulb; seen from inside and outside.
    "MAT_Lamp_Shade": {
      "baseColor": "#E8D7B9",
      "metallic": 0.0,
      "roughness": 0.85,
      "emissive": "#FFC88A",
      "emissiveStrength": 1.0,
      "doubleSided": true
    },
    // The generated rooms' lamps (the step's review): the test room's shade a little deeper, a parchment that reads warm
    // under its own bulb rather than white (MAT_Lamp_Shade stays the test room's, G01).
    "MAT_Lamp_Shade_Warm": {
      "baseColor": "#E0C49A",
      "metallic": 0.0,
      "roughness": 0.85,
      "emissive": "#FFC88A",
      "emissiveStrength": 1.0,
      "doubleSided": true
    },
    // The halls' wall sconces (I6 step 2): a parchment shade glowing amber from the bulb inside (a practical light of
    // style §4, not a source: its wash on the wall is MAT_Wall_Wash's quad, the hall's lamps light the hall).
    "MAT_Sconce_Shade": {
      "baseColor": "#C9A27C",
      "metallic": 0.0,
      "roughness": 0.85,
      "emissive": "#FFB46E",
      "emissiveStrength": 2.5,
      "doubleSided": true
    },
    // The computer studio's lamps (I6 step 3, look.md: green-shaded lamps): a banker's green glass shade, the bulb's
    // warm light through it.
    "MAT_Lamp_Shade_Green": {
      "baseColor": "#2E5A3E",
      "metallic": 0.0,
      "roughness": 0.35,
      "emissive": "#B8D89A",
      "emissiveStrength": 0.8,
      "doubleSided": true
    },
    // Printed label, meant to be multiplied by a cover texture.
    "MAT_Label_Print": { "baseColor": "#FFFFFF", "metallic": 0.0, "roughness": 0.6 },
    // The collection's covers and spines (I3 step 16): matte printed paper. At MAT_Label_Print's 0.6 a lamp's
    // highlight gathers into a bright lobe that lifts a held cover's blacks to brown at 45 degrees (step 13b); spread
    // over a rough surface its peak stays well below the print's darks.
    "MAT_Label_Cover": { "baseColor": "#FFFFFF", "metallic": 0.0, "roughness": 0.9 },

    // Returned for unknown material names (style.md section 21).
    "MAT_Fallback_Magenta": { "shading": "unlit", "baseColor": "#FF00FF" }
  }
