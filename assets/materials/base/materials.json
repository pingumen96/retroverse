// Shared material presets (style.md section 3.2), loaded by rv::assets::MaterialLibrary.
// Colors are sRGB hex art-direction starting points (style.md section 3), converted to linear on load.
// Physical plausibility: dielectrics use metallic 0 and roughness 0.3-0.95; metals use metallic 0.9-1.0 and their
// base color is the specular tint. Unlit materials are rendered as base color (times texture) scaled by
// emissiveStrength (see rv/assets/material_library.hpp).
// Procedural textures ("procedural:<surface>/<map>", rv/assets/surface_textures.hpp, generated at startup): the "full"
// surfaces carry the material's albedo and roughness themselves, tuned around its style section 3 color (named in each
// entry's comment), so their materials use a white base color and roughness and metallic factors of 1 (0 for
// dielectrics' metallic); the aged plastic "detail" surface modulates the plastics' own colors and roughness around 1.
// Furniture and room uvs are in meters (wood: 1 m per repeat along the board; floor and walls: room_shell
// metersPerTile 2, the 2 m repeat of the floor planks and the plaster).
{
  "schemaVersion": 1,
  "materials": {
    // Walnut #493024: dark grain with lighter streaks and flat-sawn arches, satin finish.
    "MAT_Wood_Walnut": {
      "baseColor": "#FFFFFF", "metallic": 0.0, "roughness": 1.0,
      "baseColorTexture": "procedural:walnut/baseColor",
      "metallicRoughnessTexture": "procedural:walnut/metallicRoughness",
      "normalTexture": "procedural:walnut/normal"
    },
    // Medium oak #76513A: open grain, satin finish (frames, trim).
    "MAT_Wood_Oak": {
      "baseColor": "#FFFFFF", "metallic": 0.0, "roughness": 1.0,
      "baseColorTexture": "procedural:oak/baseColor",
      "metallicRoughnessTexture": "procedural:oak/metallicRoughness",
      "normalTexture": "procedural:oak/normal"
    },
    // Varnished reddish-brown wood #5B3A26: straight close grain under a glossy varnish (fronts, back panels).
    "MAT_Wood_Varnished": {
      "baseColor": "#FFFFFF", "metallic": 0.0, "roughness": 1.0,
      "baseColorTexture": "procedural:varnished_wood/baseColor",
      "metallicRoughnessTexture": "procedural:varnished_wood/metallicRoughness",
      "normalTexture": "procedural:varnished_wood/normal"
    },
    // The generated rooms' varnished wood (I3 step 16): the varnished wood darker and less red (the tint takes more red
    // than blue), for the shelves' back panels and fronts and the wainscot: under the warm spots the reddish varnish
    // read orange, more saturated than the sign and the CRT; the concept's panelling is a deep brown.
    "MAT_Wood_Varnished_Dark": {
      "baseColor": "#B0A8A6", "metallic": 0.0, "roughness": 1.0,
      "baseColorTexture": "procedural:varnished_wood/baseColor",
      "metallicRoughnessTexture": "procedural:varnished_wood/metallicRoughness",
      "normalTexture": "procedural:varnished_wood/normal"
    },
    // Oak floor planks #76513A: per-plank tint, joints with a dark gap and a micro-bevel, satin varnish.
    "MAT_Floor_OakPlanks": {
      "baseColor": "#FFFFFF", "metallic": 0.0, "roughness": 1.0,
      "baseColorTexture": "procedural:oak_planks/baseColor",
      "metallicRoughnessTexture": "procedural:oak_planks/metallicRoughness",
      "normalTexture": "procedural:oak_planks/normal"
    },

    // The generated rooms' parquet (I3 step 16): the oak planks a little darker and less orange (the tint takes more
    // red than blue), so that tungsten light on a large floor reads warm brown, as in the concept, not orange.
    "MAT_Floor_Parquet": {
      "baseColor": "#D2C3BA", "metallic": 0.0, "roughness": 1.0,
      "baseColorTexture": "procedural:oak_planks/baseColor",
      "metallicRoughnessTexture": "procedural:oak_planks/metallicRoughness",
      "normalTexture": "procedural:oak_planks/normal"
    },

    "MAT_Concrete_Warm": { "baseColor": "#857B70", "metallic": 0.0, "roughness": 0.92 },
    // Smoky grey-brown paint #383735 over troweled plaster, matte.
    "MAT_Wall_Painted": {
      "baseColor": "#FFFFFF", "metallic": 0.0, "roughness": 1.0,
      "baseColorTexture": "procedural:painted_plaster/baseColor",
      "metallicRoughnessTexture": "procedural:painted_plaster/metallicRoughness",
      "normalTexture": "procedural:painted_plaster/normal"
    },
    "MAT_Plaster_Used": { "baseColor": "#9A9081", "metallic": 0.0, "roughness": 0.95 },
    // The halls' plaster above their wainscot (I6 step 2): a warm, lighter limewash than the rooms' smoky #383735, so
    // that a hall reads as the museum's connecting gallery between darker rooms; the troweled plaster's relief and
    // sheen without its colour.
    "MAT_Plaster_Warm": {
      "baseColor": "#776657", "metallic": 0.0, "roughness": 1.0,
      "metallicRoughnessTexture": "procedural:painted_plaster/metallicRoughness",
      "normalTexture": "procedural:painted_plaster/normal"
    },

    // Painted or powder-coated structural steel (railings, uprights, cabinets): the coat is a dielectric, so the
    // art-directed graphite stays visible. A bare metal this dark would reflect less than any dielectric.
    "MAT_Metal_Graphite": { "baseColor": "#252A2E", "metallic": 0.0, "roughness": 0.45 },
    // Brushed steel #B9BBBE: streaks along the brushing direction.
    "MAT_Metal_Brushed": {
      "baseColor": "#FFFFFF", "metallic": 1.0, "roughness": 1.0,
      "baseColorTexture": "procedural:brushed_metal/baseColor",
      "metallicRoughnessTexture": "procedural:brushed_metal/metallicRoughness",
      "normalTexture": "procedural:brushed_metal/normal"
    },

    // Plastics with the aged plastic detail: faint yellowing and speckle, smoother handled patches, orange peel.
    "MAT_Plastic_Black": {
      "baseColor": "#1C1C1E", "metallic": 0.0, "roughness": 0.42,
      "baseColorTexture": "procedural:aged_plastic/baseColor",
      "metallicRoughnessTexture": "procedural:aged_plastic/metallicRoughness",
      "normalTexture": "procedural:aged_plastic/normal"
    },
    "MAT_Plastic_Gray": {
      "baseColor": "#9A9A96", "metallic": 0.0, "roughness": 0.5,
      "baseColorTexture": "procedural:aged_plastic/baseColor",
      "metallicRoughnessTexture": "procedural:aged_plastic/metallicRoughness",
      "normalTexture": "procedural:aged_plastic/normal"
    },
    "MAT_Plastic_AgedIvory": {
      "baseColor": "#D6CBAE", "metallic": 0.0, "roughness": 0.48,
      "baseColorTexture": "procedural:aged_plastic/baseColor",
      "metallicRoughnessTexture": "procedural:aged_plastic/metallicRoughness",
      "normalTexture": "procedural:aged_plastic/normal"
    },
    // Desaturated purple accent for console buttons.
    "MAT_Plastic_Accent": { "baseColor": "#7D6E9E", "metallic": 0.0, "roughness": 0.4 },

    // Display-case glass: thin, blended, visible from both sides.
    // Display-case glass (I3 step 16): blended straight alpha shows alpha x the glass's own radiance over the items,
    // so a pale glass lays a milky haze over them under the key light. A dark, nearly transparent glass leaves the
    // items clear and keeps only the reflections of the lights on its panes.
    "MAT_Glass_Display": {
      "baseColor": "#1C2224",
      "alpha": 0.07,
      "alphaMode": "blend",
      "doubleSided": true,
      "metallic": 0.0,
      "roughness": 0.3
    },
    // Face of a powered-off picture tube (anti-glare coated glass).
    "MAT_Glass_CRT": { "baseColor": "#2A302E", "metallic": 0.0, "roughness": 0.3 },

    "MAT_Fabric_Sofa": { "baseColor": "#683D42", "metallic": 0.0, "roughness": 0.9 },
    // Ornamental medallion rug in the style palette (bordeaux #683D42 family, navy, cream, muted gold): a picture over
    // the rug's top face (uv 0..1), designed for the rug prefab's default 2.4 x 1.6 m.
    "MAT_Carpet_Ornate": {
      "baseColor": "#FFFFFF", "metallic": 0.0, "roughness": 1.0,
      "baseColorTexture": "procedural:ornate_rug/baseColor",
      "metallicRoughnessTexture": "procedural:ornate_rug/metallicRoughness"
    },
    // The display cases' lining (I3 step 16; lighter since step 17a's review, so that a lit case reads from the
    // doorway): a bordeaux velvet of the armchair's family, dark enough that the face-out covers stand out from it.
    "MAT_Fabric_Display": { "baseColor": "#6E3842", "metallic": 0.0, "roughness": 0.95 },
    // Storage boxes: kraft cardboard a shade darker than raw board, so the boxes stay behind the collection.
    "MAT_Cardboard_Box": { "baseColor": "#8E7151", "metallic": 0.0, "roughness": 0.85 },
    "MAT_Paper_Print": { "baseColor": "#EFEBE2", "metallic": 0.0, "roughness": 0.8 },
    // Shelf dressing (I3 step 16): magazines' coated paper, aged and glossier than poster paper (white page edges would
    // outshine the covers on the shelves); cloth book bindings in two muted colours of the palette (a forest green and a
    // navy) beside the bordeaux.
    "MAT_Paper_Magazine": { "baseColor": "#B9AE9A", "metallic": 0.0, "roughness": 0.5 },
    "MAT_Book_Cloth": { "baseColor": "#4A6450", "metallic": 0.0, "roughness": 0.85 },
    "MAT_Book_Cloth_Alt": { "baseColor": "#45547A", "metallic": 0.0, "roughness": 0.85 },
    // The plant (I3 step 16): a glazed terracotta pot, dark soil, the leaves' two greens (desaturated, style §3.1's
    // 70/20/10: a plant is a detail, never an accent).
    "MAT_Ceramic_Glazed": { "baseColor": "#7A4A33", "metallic": 0.0, "roughness": 0.4 },
    "MAT_Soil": { "baseColor": "#2B2119", "metallic": 0.0, "roughness": 0.95 },
    "MAT_Plant_Leaf": { "baseColor": "#3D5634", "metallic": 0.0, "roughness": 0.55 },
    "MAT_Plant_Leaf_Light": { "baseColor": "#69783F", "metallic": 0.0, "roughness": 0.55 },

    "MAT_Neon_Diffuser": { "shading": "unlit", "baseColor": "#B34DCE", "emissiveStrength": 1.5 },
    // The halls' portal signs (I6 step 2): backlit lettering in tungsten amber (style §3), readable from the hall without
    // a light of its own; the room's neon stays the room's accent.
    "MAT_Sign_Tungsten": { "shading": "unlit", "baseColor": "#FFC88A", "emissiveStrength": 1.2 },
    // In-world screens: multiplied by the video or test pattern texture.
    "MAT_Screen_Emissive": { "shading": "unlit", "baseColor": "#FFFFFF", "emissiveStrength": 2.0 },
    // The picture tube of a CRT television (style 15.2, CRT_Subtle of style 25): a 240-line picture with a light
    // aperture grille, a slight barrel curvature with dark rounded corners and a soft vignette, behind hazy glass
    // whose faint sheen of the room's lights shows on the tube's dark border and never washes out the picture.
    // Scanlines and grille fade out below a few pixels: legible at any distance.
    "MAT_Screen_CRT": {
      "shading": "unlit", "baseColor": "#FFFFFF", "emissiveStrength": 2.0,
      "crt": {"lineCount": 240, "scanlineStrength": 0.35, "maskTriadCount": 320, "maskStrength": 0.25,
              "curvature": 0.06, "vignette": 0.3, "glassReflection": 0.25}
    },
    // The generated rooms' CRT (I3 step 16): the same tube a little less bright, so that the filmic tonemap keeps its
    // picture's colours (at 2.0 the brightest bars roll off towards white): the screen stays the room's most saturated
    // picture beside the sign, in tungsten light.
    "MAT_Screen_CRT_Room": {
      "shading": "unlit", "baseColor": "#FFFFFF", "emissiveStrength": 1.3,
      "crt": {"lineCount": 240, "scanlineStrength": 0.35, "maskTriadCount": 320, "maskStrength": 0.25,
              "curvature": 0.06, "vignette": 0.3, "glassReflection": 0.25}
    },
    // Fabric shade lit from the inside by a warm tungsten bulb; seen from inside and outside.
    "MAT_Lamp_Shade": {
      "baseColor": "#E8D7B9",
      "metallic": 0.0,
      "roughness": 0.85,
      "emissive": "#FFC88A",
      "emissiveStrength": 1.0,
      "doubleSided": true
    },
    // The halls' wall sconces (I6 step 2): a parchment shade glowing amber from the bulb inside, warmer and dimmer than
    // the lamps' (a practical light of style §4, not a source: the hall's lamps light the hall).
    "MAT_Sconce_Shade": {
      "baseColor": "#C9A27C",
      "metallic": 0.0,
      "roughness": 0.85,
      "emissive": "#FFB46E",
      "emissiveStrength": 0.8,
      "doubleSided": true
    },
    // Printed label, meant to be multiplied by a cover texture.
    "MAT_Label_Print": { "baseColor": "#FFFFFF", "metallic": 0.0, "roughness": 0.6 },
    // The collection's covers and spines (I3 step 16): matte printed paper. At MAT_Label_Print's 0.6 a lamp's
    // highlight gathers into a bright lobe that lifts a held cover's blacks to brown at 45 degrees (step 13b); spread
    // over a rough surface its peak stays well below the print's darks.
    "MAT_Label_Cover": { "baseColor": "#FFFFFF", "metallic": 0.0, "roughness": 0.9 },

    // Returned for unknown material names (style.md section 21).
    "MAT_Fallback_Magenta": { "shading": "unlit", "baseColor": "#FF00FF" }
  }
}
