// Retroverse's shipped emulator profiles (ADR-0008 §6 and §8), programs and protocols (ADR-0020 §1, §3). Format:
// docs/i2/step-5.md, docs/i11/step-12.md, docs/i11/step-13.md and src/launcher/include/rv/launcher/emulator_profile.hpp. The profiles and programs of
// <user data>/config/emulators.json replace these by id and add others.
// No machine path: executables are located through App Paths, then the places below, where '~' is the user's home
// folder and {env:NAME} an environment variable naming a folder. Not verified on any machine (specification §11.2: a
// preset is never presented as universal): the first clean launch, or `retroverse-cli launch --test`, says so.
{
  "schemaVersion": 2,
  "profiles": [
    {
      "id": "retroarch",
      "displayName": "RetroArch",
      // The RetroArch installer registers App Paths; the other places are its usual install folders.
      "executable": {
        "appPaths": "retroarch.exe",
        "paths": [
          "~\\AppData\\Roaming\\RetroArch\\retroarch.exe",
          "{env:SYSTEMDRIVE}\\RetroArch-Win64\\retroarch.exe",
          "{env:PROGRAMFILES}\\RetroArch-Win64\\retroarch.exe",
          "{env:PROGRAMFILES}\\RetroArch\\retroarch.exe"
        ]
      },
      "arguments": ["-L", "{var:core}", "{rom}"],
      "variables": {
        // RetroArch's own cores folder; a user profile changes it when libretro_directory points elsewhere.
        "cores": "{emulator_dir}\\cores"
      },
      // A system whose core is missing is "core not found", not a launch that fails.
      "requiredFiles": ["{var:core}"],
      "wait": "direct",
      "windowTimeoutSeconds": 30,
      // ES-DE's default RetroArch core of each system (its first command in es_systems.xml).
      "systems": {
        "amiga": { "variables": { "core": "{var:cores}\\puae_libretro.dll" } },
        "amigacd32": { "variables": { "core": "{var:cores}\\puae_libretro.dll" } },
        "amstradcpc": { "variables": { "core": "{var:cores}\\cap32_libretro.dll" } },
        "atari2600": { "variables": { "core": "{var:cores}\\stella_libretro.dll" } },
        "atari5200": { "variables": { "core": "{var:cores}\\a5200_libretro.dll" } },
        "atari7800": { "variables": { "core": "{var:cores}\\prosystem_libretro.dll" } },
        "atari800": { "variables": { "core": "{var:cores}\\atari800_libretro.dll" } },
        "atarijaguar": { "variables": { "core": "{var:cores}\\virtualjaguar_libretro.dll" } },
        "atarilynx": { "variables": { "core": "{var:cores}\\handy_libretro.dll" } },
        "atarist": { "variables": { "core": "{var:cores}\\hatari_libretro.dll" } },
        "c64": { "variables": { "core": "{var:cores}\\vice_x64sc_libretro.dll" } },
        "channelf": { "variables": { "core": "{var:cores}\\freechaf_libretro.dll" } },
        "colecovision": { "variables": { "core": "{var:cores}\\bluemsx_libretro.dll" } },
        "dos": { "variables": { "core": "{var:cores}\\dosbox_pure_libretro.dll" } },
        "dreamcast": { "variables": { "core": "{var:cores}\\flycast_libretro.dll" } },
        "fds": { "variables": { "core": "{var:cores}\\mesen_libretro.dll" } },
        "gamegear": { "variables": { "core": "{var:cores}\\genesis_plus_gx_libretro.dll" } },
        "gb": { "variables": { "core": "{var:cores}\\gambatte_libretro.dll" } },
        "gba": { "variables": { "core": "{var:cores}\\mgba_libretro.dll" } },
        "gbc": { "variables": { "core": "{var:cores}\\gambatte_libretro.dll" } },
        "gc": { "variables": { "core": "{var:cores}\\dolphin_libretro.dll" } },
        "genesis": { "variables": { "core": "{var:cores}\\genesis_plus_gx_libretro.dll" } },
        "intellivision": { "variables": { "core": "{var:cores}\\freeintv_libretro.dll" } },
        "mame": { "variables": { "core": "{var:cores}\\mame_libretro.dll" } },
        "mastersystem": { "variables": { "core": "{var:cores}\\genesis_plus_gx_libretro.dll" } },
        "megadrive": { "variables": { "core": "{var:cores}\\genesis_plus_gx_libretro.dll" } },
        "n64": { "variables": { "core": "{var:cores}\\mupen64plus_next_libretro.dll" } },
        "nds": { "variables": { "core": "{var:cores}\\melondsds_libretro.dll" } },
        "neogeo": { "variables": { "core": "{var:cores}\\fbneo_libretro.dll" } },
        "nes": { "variables": { "core": "{var:cores}\\mesen_libretro.dll" } },
        "ngp": { "variables": { "core": "{var:cores}\\mednafen_ngp_libretro.dll" } },
        "ngpc": { "variables": { "core": "{var:cores}\\mednafen_ngp_libretro.dll" } },
        "odyssey2": { "variables": { "core": "{var:cores}\\o2em_libretro.dll" } },
        "pc": { "variables": { "core": "{var:cores}\\dosbox_pure_libretro.dll" } },
        "pcengine": { "variables": { "core": "{var:cores}\\mednafen_pce_libretro.dll" } },
        "pcenginecd": { "variables": { "core": "{var:cores}\\mednafen_pce_libretro.dll" } },
        "pcfx": { "variables": { "core": "{var:cores}\\mednafen_pcfx_libretro.dll" } },
        "pokemini": { "variables": { "core": "{var:cores}\\pokemini_libretro.dll" } },
        "ps2": { "variables": { "core": "{var:cores}\\pcsx2_libretro.dll" } },
        "psp": { "variables": { "core": "{var:cores}\\ppsspp_libretro.dll" } },
        "psx": { "variables": { "core": "{var:cores}\\mednafen_psx_libretro.dll" } },
        "saturn": { "variables": { "core": "{var:cores}\\mednafen_saturn_libretro.dll" } },
        "sega32x": { "variables": { "core": "{var:cores}\\picodrive_libretro.dll" } },
        "segacd": { "variables": { "core": "{var:cores}\\genesis_plus_gx_libretro.dll" } },
        "snes": { "variables": { "core": "{var:cores}\\snes9x_libretro.dll" } },
        "vic20": { "variables": { "core": "{var:cores}\\vice_xvic_libretro.dll" } },
        "virtualboy": { "variables": { "core": "{var:cores}\\mednafen_vb_libretro.dll" } },
        "wii": { "variables": { "core": "{var:cores}\\dolphin_libretro.dll" } },
        "wonderswan": { "variables": { "core": "{var:cores}\\mednafen_wswan_libretro.dll" } },
        "wonderswancolor": { "variables": { "core": "{var:cores}\\mednafen_wswan_libretro.dll" } }
      },
      "verified": false
    }
  ],
  // The programs (ADR-0020 §1): whichever ES-DE command or profile starts one, matched by its file name. "window" ranks
  // its windows on every launch; "vr" applies to a launch made in VR only, so that the game shows in a window VR can
  // capture (windowed or borderless, never exclusive fullscreen) and goes on without the focus. Retroverse never
  // writes a program's own configuration: arguments, and RetroArch's append-file, which Retroverse writes into
  // <user data>/launcher/vr. The options were read from the programs' own help text where the program was at hand
  // (docs/i11/step-12.md says which); "verified" becomes true once a game was played with it in the headset.
  "programs": [
    {
      "id": "retroarch",
      "displayName": "RetroArch",
      "files": ["retroarch.exe"],
      "window": { "prefer": [{ "classContains": "RetroArch" }] },
      "vr": {
        // Read over the user's retroarch.cfg: borderless fullscreen (a window the capture can read), no pause without
        // the focus, and no saving on exit, which would copy these lines into the user's retroarch.cfg.
        "appendConfig": {
          "option": "--appendconfig",
          "file": "retroarch.cfg",
          "joinWith": "|",
          "lines": [
            "# Written by Retroverse for games played in VR, read over retroarch.cfg; rewritten at each launch in VR.",
            "video_fullscreen = \"true\"",
            "video_windowed_fullscreen = \"true\"",
            "pause_nonactive = \"false\"",
            "config_save_on_exit = \"false\""
          ]
        },
        "inGame": "light",
        // The cores that need the GPU most.
        "heavyWith": [
          "dolphin_libretro.dll", "pcsx2_libretro.dll", "ppsspp_libretro.dll", "citra*_libretro.dll",
          "flycast_libretro.dll", "mupen64plus_next_libretro.dll", "parallel_n64_libretro.dll"
        ]
      },
      "verified": false
    },
    {
      "id": "dolphin",
      "displayName": "Dolphin",
      // Dolphin, and the forks that keep its file name and options.
      "files": ["Dolphin.exe"],
      // The render window's title holds " | " (version, CPU, backend, game); the main window's does not.
      "window": { "prefer": [{ "titleContains": " | " }] },
      "vr": {
        // -C <System>.<Section>.<Key>=<Value> sets an option for this run only (never saved): windowed, its own render
        // window, no pause and the pad read without the focus.
        "addArguments": [
          "-C", "Dolphin.Display.Fullscreen=False",
          "-C", "Dolphin.Display.RenderToMain=False",
          "-C", "Dolphin.Interface.PauseOnFocusLost=False",
          "-C", "Dolphin.Input.BackgroundInput=True"
        ],
        "inGame": "heavy"
      },
      "verified": false
    },
    {
      "id": "pcsx2",
      "displayName": "PCSX2",
      "files": ["pcsx2-qt*.exe"],
      "vr": {
        // -nofullscreen: windowed whatever its settings; -nogui: the render window alone, no game list beside it.
        "addArguments": ["-nofullscreen", "-nogui"],
        "dropArguments": ["-fullscreen", "-bigpicture"],
        "inGame": "heavy"
      },
      "verified": false
    },
    {
      "id": "duckstation",
      "displayName": "DuckStation",
      "files": ["duckstation-qt-*.exe"],
      "vr": {
        "addArguments": ["-nofullscreen", "-nogui"],
        "dropArguments": ["-fullscreen", "-bigpicture"],
        "inGame": "light"
      },
      "verified": false
    },
    {
      "id": "rpcs3",
      "displayName": "RPCS3",
      "files": ["rpcs3.exe"],
      "vr": {
        // --no-gui (ES-DE's commands) shows the game's window alone; --fullscreen would make it fullscreen.
        "dropArguments": ["--fullscreen"],
        "inGame": "heavy"
      },
      "verified": false
    },
    {
      "id": "applewin",
      "displayName": "AppleWin",
      "files": ["AppleWin.exe"],
      "vr": {
        // ES-DE's command asks for full screen with -f.
        "addArguments": ["-no-full-screen"],
        "dropArguments": ["-f", "-full-screen"]
      },
      "verified": false
    },
    {
      "id": "altirra",
      "displayName": "Altirra",
      "files": ["Altirra64.exe", "Altirra.exe", "AltirraARM64.exe"],
      // Windowed by default; /f asks for full screen.
      "vr": { "dropArguments": ["/f"] },
      "verified": false
    },
    {
      "id": "sdl2trs",
      "displayName": "sdl2trs",
      "files": ["sdl2trs*.exe"],
      // Windowed by default.
      "vr": { "dropArguments": ["-fullscreen"] },
      "verified": false
    }
  ],
  // The schemes an Internet Shortcut (.url) of ES-DE's "open the game's file" command may activate (ADR-0020 §3, I11
  // step 13), each with its launcher's own processes: their windows are never the game's, the game is a process they
  // start. Any other scheme is never activated, nor is one of these in an automated run.
  "protocols": [
    { "scheme": "steam", "launcherProcesses": ["steam.exe", "steamwebhelper.exe", "GameOverlayUI*.exe"] },
    {
      "scheme": "com.epicgames.launcher",
      "launcherProcesses": ["EpicGamesLauncher.exe", "EpicWebHelper.exe", "EOSOverlayRenderer*.exe"]
    },
    { "scheme": "goggalaxy", "launcherProcesses": ["GalaxyClient*.exe", "GOG Galaxy*.exe", "GalaxyOverlay.exe"] },
    { "scheme": "uplay", "launcherProcesses": ["upc.exe", "UplayWebCore.exe", "UbisoftConnect.exe"] },
    { "scheme": "origin2", "launcherProcesses": ["EADesktop.exe", "EALauncher.exe", "Origin.exe"] }
  ]
}
