/*
	The history plaque's card (room_plaque.rml), in Informazioni's look (game_info.rcss: palette of style 3, UI neutral
	#171B22, ivory text #F4EFE6, tungsten #FFC88A). Sizes in dp. The document covers the view (the room dimmed behind it);
	a panel in its middle holds the logo and the name, then a region that scrolls (Up and Down) with the maker, year and
	type and the description. No animations.
*/

body {
	position: absolute;
	left: 0dp;
	top: 0dp;
	width: 100%;
	height: 100%;
	margin: 0dp;
	padding: 0dp;
	background-color: #07090CD9;
	font-family: "Atkinson Hyperlegible";
	font-weight: normal;
	font-style: normal;
	font-size: 22dp;
	color: #F4EFE6;
}

div, p, h2 {
	display: block;
}

p, h2, span, img {
	focus: none;
	tab-index: none;
}

div {
	tab-index: none;
}

.panel {
	position: absolute;
	left: 22%;
	top: 8%;
	width: 56%;
	height: 84%;
	box-sizing: border-box;
	padding: 22dp 30dp 16dp 30dp;
	background-color: #171B22;
	border: 2dp #FFC88A40;
	border-radius: 18dp;
	overflow: hidden;
}

.head {
	position: absolute;
	left: 30dp;
	right: 30dp;
	top: 22dp;
	height: 190dp;
}

.body {
	position: absolute;
	left: 30dp;
	right: 30dp;
	top: 222dp;
	bottom: 52dp;
	overflow-x: hidden;
	overflow-y: auto;
	padding-right: 12dp;
}

#plaque-body scrollbarvertical {
	width: 8dp;
}

#plaque-body scrollbarvertical slidertrack {
	background-color: #F4EFE614;
	border-radius: 4dp;
}

#plaque-body scrollbarvertical sliderbar {
	background-color: #F4EFE659;
	border-radius: 4dp;
}

.kicker {
	font-size: 18dp;
	color: #FFC88A;
	margin-bottom: 10dp;
}

.logo {
	height: 72dp;
	margin-bottom: 12dp;
	text-align: center;
}

.logo img {
	height: 72dp;
}

h2 {
	font-size: 32dp;
	font-weight: bold;
	line-height: 1.15em;
}

.rows {
	margin-bottom: 14dp;
}

.row {
	display: block;
	line-height: 1.4em;
}

.key {
	display: inline-block;
	width: 160dp;
	color: #F4EFE6A0;
}

.value {
	display: inline-block;
}

.description {
	line-height: 1.4em;
	margin-bottom: 16dp;
}

.close {
	position: absolute;
	left: 30dp;
	bottom: 16dp;
	font-size: 18dp;
	color: #F4EFE680;
}
