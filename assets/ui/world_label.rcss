/*
	The hover's title label (world_label.rml), in the quick catalog's look (quick_catalog.rcss: palette of style 3, UI
	neutral #171B22, ivory text #F4EFE6, tungsten #FFC88A). Sizes in dp but its position, which the panel gives in pixels
	of the view. A single line centred over the item, over the room; it takes no input. No color transitions (RmlUi
	rebuilds the geometry of every animated frame).
*/

body {
	width: 100%;
	height: 100%;
	margin: 0dp;
	padding: 0dp;
	font-family: "Atkinson Hyperlegible";
	font-weight: normal;
	font-style: normal;
	font-size: 20dp;
	color: #F4EFE6;
}

div, span {
	focus: none;
}

#world-label {
	display: block;
	position: absolute;
	text-align: center;
	white-space: nowrap;
}

.label {
	display: inline-block;
	background-color: #171B22D9;
	border: 1dp #F4EFE633;
	border-radius: 8dp;
	padding: 4dp 12dp 5dp 12dp;
}

.unavailable {
	color: #FFC88A;
}
