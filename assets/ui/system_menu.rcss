/*
	The menu (system_menu.rml), in the directory's look (directory.rcss: palette of style 3, UI neutral #171B22 in a
	translucent carbon panel, ivory text #F4EFE6, tungsten #FFC88A for the focus, signage green #6EAF93, the warm red
	#C8645A of the pad's B). A narrow column in the middle of the view: the room keeps playing around it. Sizes in dp. No
	colour is animated (RmlUi rebuilds the geometry of every animated frame).
*/

body {
	width: 100%;
	height: 100%;
	margin: 0dp;
	padding: 0dp;
	font-family: "Atkinson Hyperlegible";
	font-weight: normal;
	font-style: normal;
	font-size: 23dp;
	color: #F4EFE6;
}

div, p, h1 {
	display: block;
}

p, h1, span {
	focus: none;
}

h1 {
	font-size: 34dp;
	font-weight: bold;
	margin-bottom: 18dp;
}

.panel {
	position: absolute;
	box-sizing: border-box;
	background-color: #171B22F0;
	border: 2dp #F4EFE61F;
	border-top: 3dp #FFC88A80;
	border-radius: 18dp;
	padding: 26dp 30dp;
}

#system-menu {
	left: 32%;
	width: 36%;
	top: 22%;
	max-height: 90%;
	overflow-y: auto;
}

.note {
	font-size: 21dp;
	color: #F4EFE6B3;
	margin-bottom: 16dp;
}

.action {
	display: block;
	padding: 10dp 22dp;
	margin-bottom: 8dp;
	font-size: 25dp;
	background-color: #FFFFFF14;
	border: 3dp #00000000;
	border-radius: 12dp;
	tab-index: auto;
}

.action.primary {
	background-color: #6EAF9340;
}

.action.danger {
	background-color: #C8645A33;
}

.action:focus {
	border-color: #FFC88A;
	background-color: #FFC88A33;
}

.action.primary:focus {
	background-color: #FFC88A;
	color: #171B22;
}

.action.danger:focus {
	background-color: #C8645A;
	border-color: #FFC88A;
	color: #FFFFFF;
}

/* Compact: views under 760 dp of the display's density tall, as the directory's. */
@media (theme: compact) {
	body { font-size: 20dp; }
	h1 { font-size: 28dp; margin-bottom: 14dp; }
	.panel { padding: 18dp 22dp; }
	#system-menu { left: 28%; width: 44%; top: 14%; }
	.note { font-size: 18dp; margin-bottom: 12dp; }
	.action { font-size: 21dp; padding: 8dp 18dp; }
}
