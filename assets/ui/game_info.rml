<rml>
<head>
	<!--
		Informazioni (I3 step 14b; ADR-0012 §5, specification §12.1): a game's description and metadata and the other
		versions of its title in the catalog with their regions, over the world's card or the quick catalog. Bound to the
		data model "game_info" of rv::ui::GameInfoScreen (src/ui/src/game_info_screen.cpp), which also names the ids
		below: keep them in step (src/ui/include/rv/ui/game_info_model.hpp, tests/unit/ui/test_media_viewer.cpp). Every
		string is written here: the screen binds catalog data as it comes, and an empty field reads "n.d." (non
		disponibile). Up and Down scroll the body, Back (B, Esc) closes, Y opens the media viewer of the same game; a
		click on a button does the same. The buttons never take the focus: the input stays with the application.
		I7 step 6 (ADR-0018 §11): rows below the text: Stato steps the four statuses, Emulatore opens the emulators list for
		this title, a version launches that version; Down past the text reaches them, a click presses them (VR's ray too).
	-->
	<title>Informazioni</title>
	<link type="text/rcss" href="game_info.rcss"/>
	<link type="text/rcss" href="hint_bar.rcss"/>
</head>
<body id="game-info" data-model="game_info">
	<div class="panel">
		<h2 id="game-info-title"><span data-if="info.title != ''">{{ info.title }}</span><span data-if="info.title == ''">Gioco senza titolo</span></h2>
		<p class="subtitle"><span data-if="info.platform != ''">{{ info.platform }}</span><span data-if="info.platform == ''">n.d.</span>, <span data-if="info.year != ''">{{ info.year }}</span><span data-if="info.year == ''">n.d.</span></p>
		<div id="game-info-body" class="body">
			<p id="info-reading" class="note" data-if="!info.details">Lettura dei dettagli dal catalogo...</p>
			<div class="rows">
				<div class="row"><span class="key">Sviluppatore</span><span class="value"><span data-if="info.developer != ''">{{ info.developer }}</span><span data-if="info.developer == ''">n.d.</span></span></div>
				<div class="row"><span class="key">Editore</span><span class="value"><span data-if="info.publisher != ''">{{ info.publisher }}</span><span data-if="info.publisher == ''">n.d.</span></span></div>
				<div class="row"><span class="key">Genere</span><span class="value"><span data-if="info.genre != ''">{{ info.genre }}</span><span data-if="info.genre == ''">n.d.</span></span></div>
				<div class="row"><span class="key">Giocatori</span><span class="value"><span data-if="info.players != ''">{{ info.players }}</span><span data-if="info.players == ''">n.d.</span></span></div>
			</div>
			<h3>Descrizione</h3>
			<p id="game-info-description" class="description" data-if="info.description != ''">{{ info.description }}</p>
			<p id="info-no-description" class="note" data-if="info.description == ''">Il catalogo non ha una descrizione di questo gioco.</p>
		</div>
		<div id="game-info-rows" class="control-rows">
			<div id="info-status" class="control" data-if="info.controls" data-class-focused="info.focus == 'status'" data-event-click="act('status')">
				<span class="control-key">Stato</span>
				<span class="control-value">
					<span data-if="info.status == 'not-started'">Da iniziare</span>
					<span data-if="info.status == 'in-progress'">In corso</span>
					<span data-if="info.status == 'completed'">Completato</span>
					<span data-if="info.status == 'abandoned'">Abbandonato</span>
					<span class="control-why" data-if="!info.statusStored"> (dedotto)</span>
					<span class="problem" data-if="info.statusFailed"> non salvato</span>
				</span>
			</div>
			<div id="info-emulator" class="control" data-if="info.controls" data-class-focused="info.focus == 'emulator'" data-event-click="act('emulator')">
				<span class="control-key">Emulatore</span>
				<span class="control-value">
					<span data-if="info.choice != ''">{{ info.choice }}</span><span data-if="info.choice == ''">Comando di ES-DE</span>
					<span class="control-why" data-if="info.own"> (scelto per questo titolo)</span>
					<span class="control-why" data-if="!info.own && info.source == 'esde-game'"> (scelto in ES-DE)</span>
					<span class="control-why" data-if="!info.own && info.source != 'esde-game'"> (scelta del sistema)</span>
				</span>
			</div>
			<div id="game-info-versions" class="versions" data-if="info.versionCount > 0">
				<div class="control version" data-for="version : versions" data-attr-id="version.elementId" data-class-focused="info.focus == 'version' && info.focusVersion == version.index" data-event-click="version(version.index)">
					<span class="version-title"><span data-if="version.title != ''">{{ version.title }}</span><span data-if="version.title == ''">Versione senza titolo</span></span>
					<span class="version-region"><span data-if="version.region != ''">{{ version.region }}</span><span data-if="version.region == ''">regione non indicata</span></span>
				</div>
				<p id="info-more-versions" class="note" data-if="info.more == 1">e un'altra versione</p>
				<p class="note" data-if="info.more > 1">e altre {{ info.more }} versioni</p>
			</div>
			<p id="info-no-versions" class="note" data-if="info.versionCount == 0">Nessun'altra versione di questo titolo nel catalogo.</p>
		</div>
		<div class="footer">
			<button id="info-media" class="action" data-event-click="act('media')">Vedi media</button>
			<div class="hints">
				<span class="hint"><span class="pad" hint-action="ui_up ui_down"></span>Scorri</span>
				<span class="hint" data-if="info.focus != ''"><span class="pad" hint-action="ui_activate"></span><span data-if="info.focus == 'version'">Avvia</span><span data-if="info.focus == 'status'">Cambia</span><span data-if="info.focus == 'emulator'">Scegli</span></span>
				<span class="hint"><span class="pad" hint-action="ui_media"></span>Vedi media</span>
				<span class="hint"><span class="pad" hint-action="ui_back"></span>Chiudi</span>
			</div>
			<button id="info-close" class="action close" data-event-click="act('close')">Chiudi</button>
		</div>
	</div>
</body>
</rml>
