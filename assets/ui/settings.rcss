/*
	The settings screen (settings.rml), in the directory's look (directory.rcss: palette of style 3, UI neutral #171B22 in
	a translucent carbon panel, ivory text #F4EFE6, tungsten #FFC88A for the focus, signage green #6EAF93, the warm red
	#C8645A of the pad's B). A column: the title, the groups' tabs, the rows (they scroll when they do not fit), the hints,
	never clipped. Sizes in dp. No colour is animated (RmlUi rebuilds the geometry of every animated frame).
*/

body {
	width: 100%;
	height: 100%;
	margin: 0dp;
	padding: 0dp;
	font-family: "Atkinson Hyperlegible";
	font-weight: normal;
	font-style: normal;
	font-size: 23dp;
	color: #F4EFE6;
}

div, p, h1 {
	display: block;
}

p, h1, span {
	focus: none;
}

h1 {
	font-size: 34dp;
	font-weight: bold;
	margin-bottom: 10dp;
}

.panel {
	position: absolute;
	box-sizing: border-box;
	background-color: #171B22F0;
	border: 2dp #F4EFE61F;
	border-top: 3dp #FFC88A80;
	border-radius: 18dp;
	padding: 24dp 28dp;
}

#settings-panel {
	display: flex;
	flex-direction: column;
	left: 16%;
	width: 68%;
	top: 6%;
	height: 88%;
}

#settings-panel h1, #st-tabs, #st-hints {
	flex: 0 0 auto;
}

#st-tabs {
	display: flex;
	flex-direction: row;
	margin-bottom: 10dp;
	border-bottom: 2dp #F4EFE61F;
}

.tab {
	display: block;
	flex: 1 1 0dp;
	text-align: center;
	padding: 6dp 8dp;
	font-size: 22dp;
	color: #F4EFE6A6;
	border-bottom: 3dp #00000000;
	white-space: nowrap;
}

.tab.active {
	color: #F4EFE6;
	border-bottom-color: #FFC88A;
}

#st-list {
	flex: 1 1 auto;
	min-height: 0dp;
	overflow-y: auto;
	padding-right: 10dp;
}

#st-list scrollbarvertical {
	width: 8dp;
}

#st-list scrollbarvertical slidertrack {
	background-color: #F4EFE614;
	border-radius: 4dp;
}

#st-list scrollbarvertical sliderbar {
	background-color: #F4EFE659;
	border-radius: 4dp;
}

.row {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 6dp 12dp;
	margin-bottom: 5dp;
	background-color: #FFFFFF0D;
	border: 3dp #00000000;
	border-radius: 12dp;
	tab-index: auto;
}

.row:focus {
	border-color: #FFC88A;
	background-color: #FFC88A1F;
}

.label {
	flex: 1 1 0dp;
	min-width: 0dp;
}

.row-note {
	font-size: 18dp;
	color: #FFC88ACC;
}

.control {
	display: flex;
	flex-direction: row;
	align-items: center;
	flex: 0 0 auto;
	width: 300dp;
	margin-left: 12dp;
}

.value {
	flex: 1 1 0dp;
	text-align: center;
	min-width: 0dp;
}

.arrow {
	display: block;
	flex: 0 0 auto;
	width: 34dp;
	height: 34dp;
	line-height: 34dp;
	text-align: center;
	border-radius: 8dp;
	background-color: #FFFFFF14;
}

.bar {
	height: 8dp;
	margin: 3dp 10dp;
	border-radius: 4dp;
	background-color: #F4EFE626;
}

.fill {
	height: 8dp;
	border-radius: 4dp;
	background-color: #6EAF93;
}

.restore {
	display: block;
	flex: 0 0 auto;
	width: 124dp;
	margin-left: 10dp;
	padding: 4dp 0dp;
	font-size: 19dp;
	text-align: center;
	color: #FFC88A;
	border-radius: 8dp;
	background-color: #FFC88A1F;
}

/* Not there, its column kept so that the rows stay aligned. */
.restore.off {
	visibility: hidden;
}

.row.all {
	display: block;
	margin-top: 6dp;
	text-align: center;
	background-color: #C8645A1F;
}

.row.all:focus {
	background-color: #C8645A66;
}

#st-hints {
	margin-top: 8dp;
	font-size: 18dp;
	color: #F4EFE6CC;
}

.hint {
	display: inline-block;
	margin-right: 22dp;
	white-space: nowrap;
}

.kbd {
	display: inline-block;
	width: 26dp;
	height: 26dp;
	line-height: 26dp;
	border-radius: 13dp;
	margin-right: 7dp;
	text-align: center;
	font-size: 16dp;
	font-weight: bold;
	color: #171B22;
}

/* A list of the Controlli group opens with its heads, over the columns of its rows. */
.list-title {
	display: flex;
	flex-direction: row;
	align-items: center;
	padding: 10dp 15dp 2dp 15dp;
	font-size: 18dp;
	color: #FFC88ACC;
}

.title-text {
	display: block;
	flex: 1 1 0dp;
}

.title-device {
	display: block;
	flex: 0 0 auto;
	width: 150dp;
	text-align: center;
}

.list-title .title-device:last-child {
	margin-right: 134dp;
}

.bind-cell {
	flex: 1 1 0dp;
	min-width: 0dp;
	text-align: center;
}

#st-capture {
	flex: 0 0 auto;
	margin-top: 8dp;
	padding: 8dp 14dp;
	border-radius: 12dp;
	background-color: #FFC88A1F;
	border: 2dp #FFC88A;
	text-align: center;
}

.capture-note {
	font-size: 18dp;
	color: #FFC88A;
}

.capture-buttons {
	display: flex;
	flex-direction: row;
	justify-content: center;
	margin-top: 6dp;
}

.capture-button {
	display: block;
	flex: 0 0 auto;
	margin: 0dp 8dp;
	padding: 4dp 14dp;
	border-radius: 8dp;
	font-size: 20dp;
	color: #F4EFE6;
	background-color: #FFFFFF14;
}

/* Compact: views under 760 dp of the display's density tall, as the directory's. */
@media (theme: compact) {
	body { font-size: 20dp; }
	h1 { font-size: 26dp; margin-bottom: 6dp; }
	.panel { padding: 14dp 20dp; }
	#settings-panel { left: 8%; width: 84%; top: 3%; height: 94%; }
	.tab { font-size: 19dp; padding: 4dp 6dp; }
	.row { padding: 3dp 10dp; margin-bottom: 4dp; }
	.row-note { font-size: 16dp; }
	.control { width: 260dp; }
	.arrow { width: 30dp; height: 30dp; line-height: 30dp; }
	.restore { width: 106dp; font-size: 17dp; }
	#st-hints { font-size: 16dp; margin-top: 6dp; }
	.kbd { width: 22dp; height: 22dp; line-height: 22dp; font-size: 14dp; }
	.title-device { width: 130dp; }
	.list-title { font-size: 16dp; padding-top: 6dp; }
	.list-title .title-device:last-child { margin-right: 116dp; }
	#st-capture { padding: 4dp 12dp; margin-top: 4dp; }
	.capture-note { font-size: 16dp; }
	.capture-button { font-size: 18dp; padding: 3dp 12dp; }
}
