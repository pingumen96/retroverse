     "materials": {"floor": "MAT_Wood_Oak", "wall": "MAT_Wall_Painted", "ceiling": "MAT_Wood_Walnut",
                   "trim": "MAT_Wood_Walnut"}},

    // Collection wall: shelf against the north wall, 2.5 cm off the wall surface (baseboard).
    {"id": "shelf_main", "prefab": "shelf", "position": [-1.5, 0.0, -4.8],
