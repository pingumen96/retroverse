// The building (ADR-0013 §1, §7; read by rv/world/building.hpp, which documents the format): its floors in the
// elevator's order and the layout constants of a floor. Every floor is its own scene; the hall runs east from the
// elevator at its west end, the rooms stand in two rows along it (the north row facing south, the south row turned by
// half a turn), each room's doorway wall against the hall.
//
// A floor holds the systems of its kinds; a floor naming generations holds those generations of its kinds only. Every
// kind but "excluded" lands on exactly one floor for each generation from 1 to 9 (home consoles and handhelds) or for
// any (the others): generations 1 and 2 on gen2, 7 to 9 on gen7, every handheld on handheld, the computers and the
// kind "other" (engines, ports, PC shortcuts, fantasy consoles, mobile) on computer. The ground floor, first, holds the
// hub and the arcade game room.
//
// Each floor's "sign" is the generic text by its elevator (I4 step 3; never a trade name). Each floor's "themePack" is
// the look of its rooms and its hall (I6 step 3, ADR-0014 §5, docs/i6/look.md); the arcade room takes its kind's
// (systems.json's arcade_after_dark) wherever it stands. Layout, in millimetres: the halls 3.0 m wide (I4's lobby 6.0 m,
// kept as the plans' provenance only); the rooms' rows start 3.0 m east of the hall's west end (the elevator's
// landing); a room's footprint on its floor is its interior grown by the wall allowance (the room template's wall,
// 150 mm); at most 12 rooms stand in a row. The ground floor's hall is the hub (I6 step 5, ADR-0014 §3, style §5.2): 18
// x 14 m and 5 m high, its rooms on its long walls from 4.35 m east of its west wall, so that the first room of a row
// (9.3 m with its walls) stands in the middle of an 18 m wall.
{
  "schemaVersion": 1,
  "floors": [
    {"id": "ground", "kinds": ["arcade"], "sign": "LOBBY AND ARCADE", "themePack": "retro_library_hub"},
    {"id": "gen2", "kinds": ["home"], "generations": [1, 2], "sign": "EARLY CONSOLES",
     "themePack": "classic_16bit_warm"},
    {"id": "gen3", "kinds": ["home"], "generations": [3], "sign": "8-BIT CONSOLES", "themePack": "classic_16bit_warm"},
    {"id": "gen4", "kinds": ["home"], "generations": [4], "sign": "16-BIT CONSOLES", "themePack": "classic_16bit_warm"},
    {"id": "gen5", "kinds": ["home"], "generations": [5], "sign": "32 AND 64-BIT CONSOLES",
     "themePack": "console_90s_collector"},
    {"id": "gen6", "kinds": ["home"], "generations": [6], "sign": "SIXTH GENERATION", "themePack": "optical_era_lounge"},
    {"id": "gen7", "kinds": ["home"], "generations": [7, 8, 9], "sign": "MODERN CONSOLES",
     "themePack": "optical_era_lounge"},
    {"id": "handheld", "kinds": ["handheld"], "sign": "HANDHELDS", "themePack": "handheld_archive"},
    {"id": "computer", "kinds": ["computer", "other"], "sign": "COMPUTERS AND MORE", "themePack": "computer_studio"}
  ],
  "layout": {
    "hallWidthMm": 3000,
    "lobbyWidthMm": 6000,
    "rowStartXMm": 3000,
    "wallAllowanceMm": 150,
    "maxRoomsPerRow": 12,
    "hub": {"lengthMm": 18000, "widthMm": 14000, "heightMm": 5000, "rowStartXMm": 4350}
  }
}
