    "riser_card": {"frame": "MAT_Paper_Print", "picture": "MAT_Label_Print"},
    // The collection's item.
    "cartridge": {"plastic_shell": "MAT_Plastic_Gray", "label": "MAT_Label_Cover", "spine": "MAT_Label_Cover"},
