  "labelPalette": ["#683D42", "#4C8BC9", "#6EAF93", "#B34DCE", "#76513A", "#252A2E", "#FFC88A", "#F4EFE6"],
  "neon": "#B34DCE",
  "neonGlow": {"intensity": 4.0, "range": 3.5},
  "lightTints": {},
  "decorationWeights": {"bookends": 0.6, "floor_lamp": 0.8, "magazine_stack": 1.0, "plant": 0.6, "poster_frame": 1.0,
                        "storage_box": 0.8, "tv_cabinet": 0.5}
