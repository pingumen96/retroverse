    "magazine_stack": {"paper": "MAT_Paper_Magazine", "cover": "MAT_Label_Print"},
    "bookends": {"metal": "MAT_Metal_Graphite", "book": "MAT_Book_Cloth", "book_alt": "MAT_Book_Cloth_Alt"},
    "plant": {"pot": "MAT_Ceramic_Glazed", "soil": "MAT_Soil", "leaves": "MAT_Plant_Leaf",
              "leaves_alt": "MAT_Plant_Leaf_Light"},
