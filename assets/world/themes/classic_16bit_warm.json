// The theme pack Classic16BitWarm (I3 step 16, style §14.1: SNES, Mega Drive and the 8- and 16-bit rooms, the floors
// gen2 to gen4 since I6 step 3; read by rv/world/room_look.hpp, which documents the format): the library materials
// (assets/materials/base/materials.json) of each prefab kind's material roles, as the room is drawn. Parquet and a
// rug, a warm smoky plaster (I6 step 3: warmer than #383735, which read cold beside the halls), dark walnut shelves lit
// inside and varnished fronts, an aged ivory CRT, a bordeaux armchair and display lining, tungsten paper and
// cardboard, a little green; the neon magenta, the labels in style §3's palette (assets::kDefaultLabelPalette).
// The built-in pack is a copy of this file (room_look.cpp, unit-tested equal).
{
  "schemaVersion": 1,
  "id": "classic_16bit_warm",
  "name": "Classic16BitWarm",
  "kinds": {
    "room_shell": {"floor": "MAT_Floor_Parquet", "wall": "MAT_Wall_Warm", "ceiling": "MAT_Wall_Warm",
                   "trim": "MAT_Wood_Walnut", "wainscot": "MAT_Wood_Varnished_Dark"},
    // Lit inside (I6 step 3): a warm strip under each board and its glow on the back panel.
    "shelf": {"wood_primary": "MAT_Wood_Walnut", "wood_secondary": "MAT_Wood_Varnished_Dark",
              "board_light": "MAT_Shelf_Light", "board_glow": "MAT_Shelf_Glow"},
    "wall_shelf": {"wood_primary": "MAT_Wood_Walnut", "wood_secondary": "MAT_Wood_Varnished_Dark",
                   "board_light": "MAT_Shelf_Light"},
    "crt": {"plastic_body": "MAT_Plastic_AgedIvory", "plastic_bezel": "MAT_Plastic_Black", "screen": "MAT_Screen_CRT_Room",
            "plastic_dark": "MAT_Plastic_Black"},
    "tv_cabinet": {"wood_primary": "MAT_Wood_Walnut", "wood_secondary": "MAT_Wood_Varnished_Dark",
                   "metal_trim": "MAT_Metal_Brushed"},
    "console_cartridge": {"plastic_body": "MAT_Plastic_Gray", "plastic_dark": "MAT_Plastic_Black",
                          "plastic_accent": "MAT_Plastic_Accent"},
    "poster_frame": {"frame": "MAT_Wood_Oak", "picture": "MAT_Paper_Print"},
    "rug": {"fabric": "MAT_Carpet_Ornate"},
