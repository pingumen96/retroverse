    // the portals' amber lettering.
    "hall": {"floor": "MAT_Floor_OakPlanks", "wall": "MAT_Plaster_Warm", "ceiling": "MAT_Plaster_Ceiling",
             "trim": "MAT_Wood_Walnut", "baseboard": "MAT_Wood_Walnut", "wainscot": "MAT_Wood_Varnished_Dark",
             "runner": "MAT_Carpet_Ornate", "beam": "MAT_Wood_Walnut", "bench": "MAT_Wood_Walnut",
             "cushion": "MAT_Fabric_Sofa", "plant": "MAT_Ceramic_Glazed", "saucer": "MAT_Ceramic_Saucer",
             "picture": "MAT_Wood_Walnut", "sconce": "MAT_Sconce_Shade", "wash": "MAT_Wall_Wash",
             "sign": "MAT_Sign_Tungsten"}
  },
  "heroParts": {
