// The lighting profile "evening" (I3 step 16, style §4.1, §4.2, §8.1; read by rv/world/room_look.hpp, which documents
// the format): the default. A '90s room at dusk lit by its own lamps: warm tungsten ceiling spots on the collection,
// amber practicals, the CRT and the sign as the most saturated light, a light magenta accent around the sign, the upper
// walls and the ceiling falling off into shadow. The plan places the lights; this file gives each role its colour,
// intensity, range and cones, so that switching profiles (world.json's "lightingProfile") moves nothing.
{
  "schemaVersion": 1,
  "id": "evening",
  "name": "Evening",
  "roles": {
    // The ceiling key over the hero wall: grounds the hero corner and its modules with the room's one soft shadow.
    "key": {"color": "#FFE6CC", "intensity": 70, "range": 12, "minOuterConeDeg": 30, "coneMarginDeg": 3,
            "innerConeRatio": 0.55},
    // The pendant over the circulation band: the fill that keeps the middle of the room and the display cases legible.
    "pendant": {"color": "#FFD7B0", "intensity": 16, "range": 10},
    // The amber lamps (the hero corner's and those standing as decoration).
    "lamp": {"color": "#FFC88A", "intensity": 4, "range": 4},
    // The picture light on the sign: a warm white the room's theme pack tints with its neon (themedLighting(), I6 step
    // 3's review), so that the 16-bit room keeps style §4.2's magenta accent and every other pack its own.
    "picture": {"color": "#FFF0E8", "intensity": 8, "range": 4, "minOuterConeDeg": 25, "coneMarginDeg": 10,
                "innerConeRatio": 0.6},
    // The wall-washers over the side-wall modules: the whole module's height in the cone.
    "wallWasher": {"color": "#FFE6CC", "intensity": 12, "range": 5, "minOuterConeDeg": 32, "coneMarginDeg": 8,
                   "innerConeRatio": 0.56}
  },
  "keyShadowStrength": 1.0,
  // The rooms' environment (and the scene's): the hemisphere's ground is the lamplight the warm floor bounces up onto
  // the ceiling and the upper walls, and the even fill the light the lamps scatter around the room (style §4.1's
  // ambient/fill layer), so that the upper walls and the ceiling never fall to black.
  "environment": {
    "clearColor": "#221E1A", "ambientSky": "#E6E2DC", "ambientGround": "#B49C88", "ambientIntensity": 0.3,
    "fillColor": "#FFE0C8", "fillIntensity": 0.22,
    "exposure": 1.5, "bloomStrength": 0.18, "bloomRadius": 0.5, "vignette": 0.05,
    "ssao": {"enabled": true, "radius": 0.4, "intensity": 1.0}
  },
  // The halls (I6 step 1, ADR-0014 §4): warmer and more even than the rooms, so that the rooms read as pools of light
  // seen through their doorways (since I6 step 2's review a little dimmer, a dark warm gallery with its sconces). Ceiling lights on the centre line, a low fill spot before each doorway aimed into
  // the room (its outer cone at least minOuterConeDeg: it lights the room's middle, not the walls beside the doorway),
  // and the hall's own environment.
  "hall": {
    "light": {"color": "#FFD0A0", "intensity": 12, "range": 9},
    "doorwayFill": {"color": "#FFD6AE", "intensity": 3.5, "range": 6, "minOuterConeDeg": 28, "coneMarginDeg": 6,
                    "innerConeRatio": 0.7},
    "environment": {"exposure": 1.5, "ambientSky": "#8A8078", "ambientGround": "#BCA08A", "ambientIntensity": 0.38,
                    "fillColor": "#FFDCC0", "fillIntensity": 0.15},
    // The ground floor's lobby keeps the halls' brighter ambient of I6 step 1 until it becomes the hub (I6 step 5).
    "lobbyEnvironment": {"exposure": 1.5, "ambientSky": "#8A8078", "ambientGround": "#BCA08A",
                         "ambientIntensity": 0.45, "fillColor": "#FFDCC0", "fillIntensity": 0.15}
  },
  // Lights of the look alone, drawn while the room's sixteen lights leave room for them (in this order).
  "accents": [
    // The tube's cool spill on the rug and the cabinet in front of it (style §4.3: a fictitious light near the TV).
    {"name": "crt_glow", "anchor": "crt", "type": "spot", "position": [0.0, 0.3, 0.42], "target": [0.0, -0.1, 1.4],
     "color": "#D2D8E4", "intensity": 2.5, "range": 3.5, "innerConeDeg": 45, "outerConeDeg": 80},
    // The neon's glow on the wall around the sign (the room's pack gives its colour, and its intensity and range: its
    // "neonGlow", I6 step 3).
    {"name": "sign_glow", "anchor": "sign", "type": "point", "position": [0.0, 0.0, 0.3], "color": "#B34DCE",
     "intensity": 1.5, "range": 2.5},
    // A museum spot over each display case (style §4.1's accent lights on the cases): from above the aisle onto its
    // levels, so that the covers read behind the glass and the case reads lit from the doorway.
    {"name": "case_light", "on": "display", "anchor": "display_case", "type": "spot", "position": [0.0, 1.95, 0.6],
     "target": [0.0, 0.62, -0.02], "color": "#FFEBD2", "intensity": 5, "range": 3.5, "innerConeDeg": 22,
     "outerConeDeg": 38},
    // A picture spot on the featured wall shelf beside the hero corner (the first featured titles stand there).
    {"name": "shelf_light", "on": "display", "anchor": "wall_shelf", "type": "spot", "position": [0.0, 2.6, 1.3],
     "target": [0.0, 1.28, 0.02], "color": "#FFEBD2", "intensity": 8, "range": 3.5, "innerConeDeg": 12,
     "outerConeDeg": 22}
  ]
}
