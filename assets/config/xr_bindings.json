        "north": ["/user/hand/left/input/trackpad/click"],
        "start": ["/user/hand/left/input/menu/click"],
        "left_shoulder": ["/user/hand/left/input/squeeze/click"],
        "right_shoulder": ["/user/hand/right/input/squeeze/click"],
