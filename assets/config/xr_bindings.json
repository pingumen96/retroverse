    {
      "profile": "/interaction_profiles/khr/simple_controller",
      "bindings": {
        "select": ["/user/hand/left/input/select/click", "/user/hand/right/input/select/click"],
        "start": ["/user/hand/left/input/menu/click"],
        "east": ["/user/hand/right/input/menu/click"],
