      "bindings": {
        "left_stick": ["/user/hand/left/input/trackpad"],
        "right_stick": ["/user/hand/right/input/trackpad"],
        "back": ["/user/hand/left/input/squeeze/click"],
        "south": ["/user/hand/right/input/trackpad/click"],
        "east": ["/user/hand/right/input/menu/click"],
        "north": ["/user/hand/left/input/trackpad/click"],
        "start": ["/user/hand/left/input/menu/click"],
        "right_shoulder": ["/user/hand/right/input/squeeze/click"],
        "select": ["/user/hand/left/input/trigger/value", "/user/hand/right/input/trigger/value"],
